{
  "name": "Saket745 Live Dashboard",
  "description": "Real-time glassmorphic GitHub profile telemetry for Saket745.",
  "url": "https://YOUR-DOMAIN.example",
  "hook_attributes": {
    "url": "https://YOUR-DOMAIN.example/webhooks/github",
    "active": true
  },
  "redirect_url": "https://YOUR-DOMAIN.example/",
  "public": false,
  "default_permissions": {
    "metadata": "read",
    "contents": "read",
    "issues": "read",
    "pull_requests": "read"
  },
  "default_events": [
    "push",
    "pull_request",
    "issues",
    "issue_comment",
    "repository",
    "star",
    "fork",
    "release",
    "pull_request_review",
    "pull_request_review_comment"
  ]
}
